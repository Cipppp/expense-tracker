// Prisma schema for the Expense Tracker.
//
// Production uses Postgres (Vercel Postgres / Neon / Supabase). For local dev,
// either point DATABASE_URL at a local Postgres (e.g. docker run -p 5432:5432
// -e POSTGRES_PASSWORD=local postgres:16) or use the production DB directly.
//
// Money is stored in *minor units* — RON bani (1/100 RON), USD cents.
// All amounts are integers to avoid floating-point drift. UI converts on display.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id          String   @id @default(cuid())
  // Date the transaction occurred (Started Date in Revolut, normalized to local day).
  date        DateTime
  description String
  category    String   @default("Other")
  amountRon   Int      // in bani (minor units), positive number for an expense
  amountUsd  Int      // in cents
  fxRate      Float    // RON→USD rate used for this row
  merchant    String   // canonical merchant key (e.g. "wolt", "lidl")
  source      String   @default("manual") // "revolut" | "manual" | "import"
  // Composite signature used for cross-import dedup: `YYYY-MM-DD|desc|amount`.
  dedupKey    String
  // Per-CSV sortKey from Revolut (Started Date timestamp). Helps with twin detection.
  sortKey     String?
  // When true, this row stays in the table for reference but is filtered
  // out of every aggregate / chart / total. Useful for own-account transfers,
  // refunds, or anything that shouldn't count as spending.
  excluded    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([dedupKey])
  @@index([merchant])
  @@index([excluded])
}

model Income {
  id           String   @id @default(cuid())
  date         DateTime
  description  String
  // Either jobId (preferred) or `source` for back-compat with old rows.
  jobId        String?
  job          Job?     @relation(fields: [jobId], references: [id])
  source       String
  // 15-min-step time range, in MINUTES from midnight (0–1440). Null for
  // lump-sum / project payments where the time of day doesn't matter.
  startMinutes Int?
  endMinutes   Int?
  hours        Float?
  hourlyRate   Float?
  // Currency this entry was billed in. Clients are not all on one currency
  // (NETOP and Aethra invoice in EUR, BLNG in USD, FUSECON in RON) and some
  // clients straddle two — Rudig's Upwork milestones were USD while its
  // direct invoices are EUR — so the currency belongs on the ENTRY, not on
  // the job.
  currency     String   @default("USD") // USD | EUR | RON
  // Minor units of `currency` (cents / bani), despite the legacy name.
  // Aggregates convert to USD via Settings.fxEurToUsd / fxRonToUsd.
  amountUsd    Int
  notes        String?
  // Optional link to the invoice that billed this entry. Set when the user
  // generates an invoice from logged hours; cleared (SetNull) if the invoice
  // is deleted so the hours reappear as unbilled in the dashboard.
  invoiceId    String?
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@index([jobId])
  @@index([source])
  @@index([invoiceId])
}

model Job {
  id        String   @id @default(cuid())
  name      String   @unique
  rateUsd   Float    // USD per hour
  color     String   @default("#c65c2a")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Legal entity that this client invoices through. Used to autofill the
  // invoice header when creating a new invoice for this client.
  companyName     String?
  companyCui      String?         // CIF in Romania, VAT ID elsewhere
  companyReg      String?         // J-number in RO, CVR in DK, etc.
  companyAddress  String?
  companyCountry  String?         // ISO country (RO, DK, US, ...)
  defaultCurrency String   @default("USD") // USD | EUR | RON — currency the work is billed in
  // Where to email invoices for this client. When set, the invoice page can
  // send the PDF + activity report straight to the client.
  email           String?

  entries   Income[]
  invoices  Invoice[]
}

// Invoice issued by Project CIP SRL to a client.
model Invoice {
  id           String   @id @default(cuid())
  number       String   @unique               // formatted: "0012"
  series       String   @default("CP")        // series prefix
  seriesNumber Int                            // 12, 15… for ordering / next-number lookup

  issuedAt     DateTime
  dueAt        DateTime?

  // Foreign-key to client. Optional — if the client is later deleted, the
  // invoice keeps its snapshotted name/CUI/address fields.
  jobId        String?
  job          Job?     @relation(fields: [jobId], references: [id])

  // Snapshot of client info at issue time (legal addresses / VAT IDs can
  // change; old invoices must keep their old data).
  clientName      String
  clientCompany   String
  clientCui       String?
  clientReg       String?
  clientAddress   String?
  clientCountry   String?

  // Currency the work was billed in. The line totals + grand total are
  // displayed in `legalCurrency` (always RON for a RO SRL). `bnrRate` is
  // the RON-per-unit rate of `invoiceCurrency` on issue date.
  invoiceCurrency String  @default("RON")     // RON | USD | EUR
  legalCurrency   String  @default("RON")
  bnrRate         Float?                      // RON per invoiceCurrency unit (e.g. 4.4085)
  // VAT rate applied to the net. 0.21 for Romanian B2B clients; 0 for
  // intra-community EU B2B (reverse charge — "taxare inversă"). Snapshotted
  // per invoice so historical rate changes don't rewrite old invoices.
  vatRate         Float   @default(0)

  footerNote   String?
  status       String   @default("draft")     // draft | issued | paid | void
  paidAt       DateTime?
  paidIncomeId String?  @unique               // linked Income row created on mark-paid

  lines        InvoiceLine[]
  // Time entries (Income rows) that this invoice bills. Set when the user
  // generates an invoice from logged hours; cleared automatically when the
  // invoice is deleted (Income.invoice uses onDelete: SetNull).
  billedEntries Income[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([issuedAt])
  @@index([jobId])
  @@index([status])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int                                // 1-based ordering within the invoice
  description String
  unit        String  @default("buc")            // U.M. — "buc" or "h"
  quantity    Float
  unitPrice   Float                              // in invoiceCurrency
  // amount = quantity * unitPrice, stored to avoid float roundoff drift.
  amount      Float

  @@index([invoiceId])
}

// Recurring expense (subscription). Predicted to repeat each cycle until
// `endsAt` (null = forever). Used to overlay "expected" segments on the
// dashboard for future months.
model Subscription {
  id          String   @id @default(cuid())
  name        String                              // "Netflix", "AWS", "GitHub", ...
  category    String   @default("Subscriptions")
  amountRon   Int                                 // bani — the predicted RON cost per cycle
  amountUsd   Int                                 // cents — at the time of creation
  fxRate      Float                               // RON→USD rate captured at creation
  frequency   String   @default("monthly")        // monthly | yearly
  dayOfMonth  Int      @default(1)                // 1-31, when in the cycle it bills
  startsAt    DateTime @default(now())
  endsAt      DateTime?                           // null = ongoing
  active      Boolean  @default(true)
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

// Single-row settings table.
/*
 * Taxe platite efectiv, extrase din extrasul bancar al firmei.
 *
 * Proiectia de pe dashboard raspunde la "cat o sa datorez"; asta raspunde la
 * "cat am dat deja si pentru ce luna". Sunt doua intrebari diferite si pana
 * acum a doua nu avea raspuns nicaieri in aplicatie.
 *
 * `forPeriod` e luna ACOPERITA, nu cea in care s-a facut plata: "BS+BAS
 * martie" se plateste pe 4 mai, iar comparatia lunara are sens doar dupa luna
 * acoperita.
 */
model TaxPayment {
  id          String   @id @default(cuid())
  paidAt      DateTime
  forPeriod   String?              // "2026-03"
  kind        String               // bs_bas | dividende | venit | micro | cam | tva | alte
  amountRon   Int                  // in bani
  description String
  // Cheie naturala din extras (data + suma + eticheta), ca reimportarea
  // aceluiasi extras sa nu duplice nimic.
  dedupKey    String   @unique
  createdAt   DateTime @default(now())

  @@index([paidAt])
  @@index([forPeriod])
  @@index([kind])
}

/*
 * Investitii si economii — averea personala, in aceeasi aplicatie.
 *
 * Impartirea sursele: CE si CAT detii se scrie o data (sau vine din broker),
 * dar CAT VALOREAZA se recalculeaza din pretul live la fiecare incarcare a
 * paginii. Asa net worth-ul se misca singur fara sa stocam preturi vechi.
 */
model Holding {
  id        String   @id @default(cuid())
  symbol    String                        // simbol Yahoo: MSFT, VWCE.DE
  name      String?
  quantity  Float
  avgCost   Float?                        // pret mediu de achizitie, in `currency`
  currency  String   @default("USD")      // moneda listarii
  source    String   @default("manual")   // IBKR | XTB | manual
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, source])
  @@index([source])
}

model SavingsAccount {
  id        String   @id @default(cuid())
  label     String
  amountRon Int      @default(0)          // in bani, dupa conversie la salvare
  amount    Float    @default(0)          // suma in moneda ei
  currency  String   @default("RON")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Un rand pe zi, pentru graficul de evolutie a averii. */
model NetWorthSnapshot {
  day        String   @id                 // "2026-08-30", ziua in Europe/Bucharest
  stocksRon  Int
  savingsRon Int
  totalRon   Int
  takenAt    DateTime @default(now())
}

model Settings {
  id              Int    @id @default(1)
  // App-wide display currency. Storage is unchanged (USD cents for income,
  // RON bani for expenses) — this only affects formatting in the UI.
  displayCurrency String @default("USD") // USD | RON
  // Bearer token for the external time-log API (/api/timelog). Lets tools
  // like Conductor POST hours without a browser session. Null = disabled.
  timelogToken    String?
  fxRonToUsd      Float  @default(0.2255)
  // USD per 1 EUR. Needed to total earnings across clients billed in
  // different currencies; ~5.2473 RON/EUR x 0.2255 USD/RON as of Aug 2026.
  fxEurToUsd      Float  @default(1.1833)
  // Romanian micro-enterprise tax inputs.
  bsBasRon        Int    @default(141500) // 1415.00 RON in bani
  camRon          Int    @default(8400)   //   84.00 RON in bani
  microPct        Float  @default(0.01)   // 1% impozit micro
  dividendePct    Float  @default(0.16)   // 16% impozit dividende
  vatRate         Float  @default(0.21)   // 21% TVA standard rate (RO clients)
  // Inregistrarea normala in scopuri de TVA (art. 316). Anulata prin decizia
  // F700 din 03.08.2026: firma a trecut la regimul de scutire art. 310, deci
  // nu mai colecteaza TVA pe facturile interne.
  vatRegistered   Boolean @default(true)
  // Codul special de TVA pentru operatiuni intracomunitare (art. 317). ANAF
  // atribuie un cod DISTINCT de CIF-ul firmei, valabil in VIES, care se pune
  // pe facturile catre clienti din UE in locul CIF-ului. Nu face firma
  // platitoare de TVA. Certificat seria W nr. 10052639, valabil din 10.08.2026.
  issuerVatIntra  String @default("")
  redThresholdRon Int    @default(5000)   // 50 RON/day in bani → row turns red
  // Lower-bound month (defaults to Apr 2026 — start date in the Excel).
  startYear       Int    @default(2026)
  startMonth      Int    @default(4)

  // Issuer details — used in the invoice header.
  issuerName     String @default("PROJECT CIP S.R.L.")
  issuerCif      String @default("51711091")
  issuerReg      String @default("J2025030670009")
  issuerAddress  String @default("Bld Dacia, Nr.133, Et.d, Sector 2, Jud. Bucuresti")
  issuerIban     String @default("RO95INGB0000999918378858")  // RON account
  issuerIbanEur  String @default("")                          // EUR account — used on EUR invoices
  issuerSwift    String @default("INGBROBU")                  // BIC/SWIFT (same for all ING RO accounts)
  issuerBank     String @default("ING BANK NV")
  issuerCapital  String @default("200 Lei")
  issuerSigner   String @default("Ciprian Pirvu")
  // Sender identity for outgoing invoice emails (must be a domain verified
  // with the email provider — see RESEND_API_KEY).
  senderEmail    String @default("")
  senderName     String @default("PROJECT CIP S.R.L.")
  invoiceSeries  String @default("CP")            // prefix; next number derived from DB
  // Floor for the next invoice number. Lets the series continue from an
  // external tool (e.g. SmartBill issued up to CP0018 → set this to 19 so the
  // app's next invoice is CP0019, not CP0001).
  invoiceStartNumber Int @default(1)

  // Household chores rotation: which person is on "Rândul 1" vs "Rândul 2".
  // Base assignment alternates by ISO-week parity; this flag flips the phase
  // so a one-tap "Swap" lines it up with reality for good.
  choresFlip      Boolean @default(false)

  updatedAt       DateTime @updatedAt @default(now())
}

// One row per ISO week ("2026-W23") tracking which chores got ticked off.
// `done` holds keys shaped "set-dayIndex-choreIndex" (e.g. "2-1-0"). Shared,
// so both partners see the same checkmarks.
/*
 * Sarcinile casnice. Erau o constanta in cod; acum se pot adauga si sterge.
 *
 * Bifele se tin pe ID-ul sarcinii, nu pe pozitia ei. Cu chei de forma
 * "set-zi-index", stergerea unei sarcini muta indicii celor de dupa si bifele
 * ar cadea pe alta sarcina.
 */
model Chore {
  id        String   @id @default(cuid())
  setId     Int                          // 1 = Randul 1, 2 = Randul 2
  day       Int                          // 0 = Luni … 6 = Duminica
  label     String
  shopping  Boolean  @default(false)     // marcaj Bringo
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([setId, day, position])
}

model ChoreWeek {
  isoWeek   String   @id
  done      String[] @default([])
  updatedAt DateTime @updatedAt @default(now())
}

// "Lista pentru care merită să trăim" — an append-only gratitude list both
// partners add to, one little thing at a time. `author` is "cip" | "axy" (or
// null if unattributed).
model GratitudeItem {
  id        String   @id @default(cuid())
  text      String
  author    String?
  photoKey  String?  // S3 object key in the private photos bucket (optional)
  pinned    Boolean  @default(false)
  tags      String[] @default([])
  createdAt DateTime @default(now())

  reactions GratitudeReaction[]

  @@index([createdAt])
}

// WhatsApp-style reactions: one per person per entry (any emoji), replaceable.
model GratitudeReaction {
  id        String        @id @default(cuid())
  itemId    String
  person    String        // "cip" | "axy"
  emoji     String
  createdAt DateTime      @default(now())
  item      GratitudeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, person])
  @@index([itemId])
}

// One row per (day, person, supplement) with how many units were taken that
// day. `day` is a Bucharest-local "yyyy-mm-dd"; `key` references the static
// catalog in src/lib/supplements.ts.
/*
 * Catalogul de suplimente. Era o constanta in cod; acum se pot adauga si
 * scoate din interfata.
 *
 * `key` ramane identificatorul stabil, pentru ca SupplementLog scrie pe el:
 * schimbarea numelui unui produs nu trebuie sa piarda istoricul bifelor.
 * Campurile bogate (compozitie, interactiuni, contributii la doza zilnica) au
 * sens doar pentru produsele cercetate; ce adaugi tu le lasa goale.
 */
model Supplement {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  brand        String   @default("")
  short        String   @default("")
  benefits     String[]
  unit         String   @default("capsulă")
  target       Int      @default(1)
  timing       String                       // morning | noon | evening | preworkout
  timingNote   String   @default("")
  foodNote     String   @default("")
  composition  String   @default("")
  interactions String[]
  cautions     String[]
  daily        Boolean  @default(true)
  suggestedFor String?                      // cip | axy | null = amandoi
  contributes  Json?
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([timing, position])
}

model SupplementLog {
  id        String   @id @default(cuid())
  day       String
  person    String // "cip" | "axy"
  key       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @default(now())

  @@unique([day, person, key])
  @@index([day])
}

// Tracks Revolut CSVs that have already been processed (filename + line hash).
model ImportBatch {
  id          String   @id @default(cuid())
  filename    String
  rowsRead    Int
  rowsInsert  Int
  rowsSkipped Int
  createdAt   DateTime @default(now())
}

// Auto-categorization rules: substring → category.
model CategoryRule {
  id        String @id @default(cuid())
  keyword   String @unique          // lowercase substring matched against description
  category  String
  priority  Int    @default(100)    // lower = higher priority
}

// WebAuthn / Passkey credentials. Single user so no FK — all passkeys belong
// to "the owner". credentialId is the WebAuthn credential id (base64url).
model Passkey {
  id            String   @id @default(cuid())
  label         String                          // user-friendly: "iPhone", "MacBook Touch ID"
  credentialId  String   @unique                // base64url-encoded credential id
  publicKey     Bytes                           // CBOR-encoded public key
  counter       Int      @default(0)            // authenticator signature counter (for clone detection)
  transports    String   @default("")           // comma-joined: "internal,hybrid,usb"
  deviceType    String   @default("singleDevice") // "singleDevice" | "multiDevice" (synced cred)
  backedUp      Boolean  @default(false)
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  @@index([credentialId])
}
