# Local dev uses SQLite at prisma/dev.db.
# For Vercel deploy, point DATABASE_URL at Neon / Supabase / Vercel Postgres
# (and change provider in prisma/schema.prisma from "sqlite" to "postgresql").
DATABASE_URL="file:./dev.db"

# 32+ char random string used by iron-session to sign cookies.
SESSION_SECRET=""

# Single-user access password. Anyone with this can read your data.
ACCESS_PASSWORD=""

# Oblio — emiterea facturii si in contul de facturare, care o duce mai departe
# la SPV. OBLIO_EMAIL e adresa de login, OBLIO_SECRET e tokenul din
# Setari > Date firma. Fara ele, butonul "Issue in Oblio" nu apare.
OBLIO_EMAIL=
OBLIO_SECRET=

# ANAF e-Factura direct (fara Oblio). Client ID/Secret vin din contul de
# dezvoltator ANAF (anaf.ro > Servicii Online > Inregistrare utilizatori >
# DEZVOLTATORI APLICATII), unde aplicatia se inregistreaza cu callback-ul de
# mai jos. Callback-ul NU se poate edita dupa creare — pune domeniul final.
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_REDIRECT_URI=https://house.cefani.com/api/anaf/oauth/callback
# test = api.anaf.ro/test/FCTEL (nimic nu ajunge la clienti); prod = real.
ANAF_ENV=test
# 32 de octeti aleatori, base64: `openssl rand -base64 32`. Cripteaza
# tokenurile OAuth in baza de date.
ANAF_TOKEN_ENC_KEY=
# Vercel il trimite in header la /api/cron/efactura. Orice string lung.
CRON_SECRET=
# Unde se trimit alertele (token pe expirare, factura cu termen aproape).
# Foloseste RESEND_API_KEY + senderEmail din Settings.
ANAF_ALERT_EMAIL=
